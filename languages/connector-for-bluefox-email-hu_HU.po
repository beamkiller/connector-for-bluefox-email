#. Plugin Name of the plugin
#: connector-for-bluefox-email.php
msgid "Connector for bluefox.email – Newsletter & WooCommerce Emails"
msgstr "Connector for bluefox.email – Hírlevél és WooCommerce e-mailek"

#. Plugin URI of the plugin
#: connector-for-bluefox-email.php
msgid "https://wordpress.org/plugins/connector-for-bluefox-email/"
msgstr "https://wordpress.org/plugins/connector-for-bluefox-email/"

#. Description of the plugin
#: connector-for-bluefox-email.php
msgid "Connect WordPress and WooCommerce to bluefox.email: signup forms with double opt-in, checkout opt-in, welcome coupons, contact sync, WooCommerce emails and wp_mail delivery."
msgstr "A WordPress és a WooCommerce összekapcsolása a bluefox.email szolgáltatással: feliratkozó űrlapok dupla megerősítéssel (double opt-in), feliratkozás a pénztárban, üdvözlő kuponok, kontakt szinkronizálás, WooCommerce e-mailek és wp_mail kézbesítés."

#. Author of the plugin
#: connector-for-bluefox-email.php
msgid "Peter Kulcsár - KREMONT s.r.o."
msgstr "Peter Kulcsár - KREMONT s.r.o."

#. Author URI of the plugin
#: connector-for-bluefox-email.php
msgid "https://www.linkedin.com/in/peterkulcsar/"
msgstr "https://www.linkedin.com/in/peterkulcsar/"

